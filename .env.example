# Copy to .env and fill in values:
#   cp .env.example .env
#
# Load before starting the backend (from repo root):
#   set -a && source .env && set +a
#
# The canonical demo replay does NOT need these keys.
# They are only required for live OpenAI agent/safety calls.
# Never commit real API keys.

OPENAI_API_KEY=your-openai-api-key-here

# Live runtime model configuration
OPENAI_AGENT_MODEL=gpt-5.6-terra
OPENAI_MODEL=gpt-5.6-luna

# Optional: enable the explicitly-authorized bounded live evaluation
# RUN_LIVE_LLM_TESTS=1
