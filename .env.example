# Copy to .env and fill in values:
#   cp .env.example .env
#
# Load before starting the backend (from repo root):
#   set -a && source .env && set +a
#
# The canonical demo replay does NOT need these keys.
# They are only required for live OpenAI agent/safety calls.

OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown):
# OPENAI_AGENT_MODEL=gpt-5.6-luna
# OPENAI_MODEL=gpt-5.6-luna

# Optional: enable opt-in live LLM smoke tests
# RUN_LIVE_LLM_TESTS=1
